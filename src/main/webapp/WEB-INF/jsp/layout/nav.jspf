<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="navbar">
    <div class="container">
        <a href="${pageContext.request.contextPath}/" class="brand-logo" id="nav-brand">
            <span>SkillSwap</span><span class="brand-dot">•</span>
        </a>
        <nav>
            <ul class="nav-links">
                <li><a href="${pageContext.request.contextPath}/browse" id="nav-browse">Browse</a></li>
                <li><a href="${pageContext.request.contextPath}/leaderboard" id="nav-leaderboard">Leaderboard</a></li>

                <c:choose>
                    <c:when test="${empty sessionScope.currentUser}">
                        <li><a href="${pageContext.request.contextPath}/login" id="nav-login">Sign In</a></li>
                        <li><a href="${pageContext.request.contextPath}/register" class="btn btn-accent btn-sm" id="nav-register">Join Now</a></li>
                    </c:when>
                    <c:otherwise>
                        <c:if test="${sessionScope.currentUser.role == 'STUDENT'}">
                            <li><a href="${pageContext.request.contextPath}/dashboard" id="nav-dashboard">Dashboard</a></li>
                            <li><a href="${pageContext.request.contextPath}/matches" id="nav-matches">Matches</a></li>
                            <li><a href="${pageContext.request.contextPath}/skills" id="nav-skills">My Skills</a></li>
                            <li><a href="${pageContext.request.contextPath}/availability" id="nav-availability">Schedule</a></li>
                            <li><a href="${pageContext.request.contextPath}/requests" id="nav-requests">Requests</a></li>
                            <li><a href="${pageContext.request.contextPath}/messages" id="nav-messages">Messages</a></li>
                            <li>
                                <a href="${pageContext.request.contextPath}/notifications" id="nav-notifications">
                                    Alerts
                                    <c:if test="${not empty unreadNotificationsCount && unreadNotificationsCount > 0}">
                                        <span class="nav-badge"><c:out value="${unreadNotificationsCount}"/></span>
                                    </c:if>
                                </a>
                            </li>
                            <li><a href="${pageContext.request.contextPath}/credits" id="nav-credits">Credits</a></li>
                        </c:if>

                        <c:if test="${sessionScope.currentUser.role == 'ADMIN'}">
                            <li><a href="${pageContext.request.contextPath}/admin" id="nav-admin-dashboard">Admin Overview</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/users" id="nav-admin-users">Users</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/catalog" id="nav-admin-catalog">Catalog</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/reports" id="nav-admin-reports">Reports</a></li>
                        </c:if>

                        <li class="nav-user">
                            <a href="${pageContext.request.contextPath}/profile" id="nav-profile" title="View Profile" style="padding:0;">
                                <div class="nav-avatar">
                                    <c:choose>
                                        <c:when test="${not empty sessionScope.currentUser.avatarPath}">
                                            <img src="${pageContext.request.contextPath}/avatar?id=${sessionScope.currentUser.id}" alt="Avatar" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
                                        </c:when>
                                        <c:otherwise>
                                            <c:out value="${fn:substring(sessionScope.currentUser.name, 0, 1)}"/>
                                        </c:otherwise>
                                    </c:choose>
                                </div>
                            </a>
                            <form action="${pageContext.request.contextPath}/logout" method="post" style="display:inline;margin:0;">
                                <input type="hidden" name="_csrf" value="${csrfToken}">
                                <button type="submit" class="btn btn-outline btn-sm" id="btn-logout" style="color:#FFFFFF;border-color:rgba(255,255,255,0.4);">Sign Out</button>
                            </form>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </nav>
    </div>
</header>

<c:set var="hasFlash" value="${not empty flashSuccess || not empty flashError || not empty flashWarning || not empty flashInfo}" />
<c:if test="${hasFlash}">
    <div class="container flash-container" id="flash-container">
        <c:if test="${not empty flashSuccess}">
            <div class="flash-message flash-success" id="flash-success-box" role="alert" data-auto-dismiss="4500">
                <div class="flash-content">
                    <span class="flash-icon" aria-hidden="true">&#10003;</span>
                    <span class="flash-text"><c:out value="${flashSuccess}"/></span>
                </div>
                <button type="button" class="flash-close" aria-label="Close notification" title="Dismiss">&times;</button>
                <div class="flash-progress"><div class="flash-progress-bar"></div></div>
            </div>
        </c:if>
        <c:if test="${not empty flashError}">
            <div class="flash-message flash-error" id="flash-error-box" role="alert" data-auto-dismiss="5500">
                <div class="flash-content">
                    <span class="flash-icon" aria-hidden="true">&#10005;</span>
                    <span class="flash-text"><c:out value="${flashError}"/></span>
                </div>
                <button type="button" class="flash-close" aria-label="Close notification" title="Dismiss">&times;</button>
                <div class="flash-progress"><div class="flash-progress-bar"></div></div>
            </div>
        </c:if>
        <c:if test="${not empty flashWarning}">
            <div class="flash-message flash-warning" id="flash-warning-box" role="alert" data-auto-dismiss="5000">
                <div class="flash-content">
                    <span class="flash-icon" aria-hidden="true">&#9888;</span>
                    <span class="flash-text"><c:out value="${flashWarning}"/></span>
                </div>
                <button type="button" class="flash-close" aria-label="Close notification" title="Dismiss">&times;</button>
                <div class="flash-progress"><div class="flash-progress-bar"></div></div>
            </div>
        </c:if>
        <c:if test="${not empty flashInfo}">
            <div class="flash-message flash-info" id="flash-info-box" role="alert" data-auto-dismiss="4500">
                <div class="flash-content">
                    <span class="flash-icon" aria-hidden="true">&#8505;</span>
                    <span class="flash-text"><c:out value="${flashInfo}"/></span>
                </div>
                <button type="button" class="flash-close" aria-label="Close notification" title="Dismiss">&times;</button>
                <div class="flash-progress"><div class="flash-progress-bar"></div></div>
            </div>
        </c:if>
    </div>
    <c:remove var="flashSuccess" scope="session"/>
    <c:remove var="flashError" scope="session"/>
    <c:remove var="flashWarning" scope="session"/>
    <c:remove var="flashInfo" scope="session"/>
    <c:remove var="SKILLSWAP_FLASH_MESSAGE" scope="session"/>

    <script>
    (function() {
        function initFlashMessages() {
            var messages = document.querySelectorAll('.flash-message');
            messages.forEach(function(msg) {
                var duration = parseInt(msg.getAttribute('data-auto-dismiss'), 10) || 4500;
                var progressBar = msg.querySelector('.flash-progress-bar');
                var closeBtn = msg.querySelector('.flash-close');
                var timeoutId = null;
                var startTime = Date.now();
                var remaining = duration;
                var isPaused = false;

                function dismiss() {
                    if (msg.classList.contains('flash-dismissing')) return;
                    msg.classList.add('flash-dismissing');
                    setTimeout(function() {
                        if (msg.parentNode) {
                            var parent = msg.parentNode;
                            parent.removeChild(msg);
                            if (parent.querySelectorAll('.flash-message').length === 0) {
                                parent.style.display = 'none';
                            }
                        }
                    }, 380);
                }

                function startTimer() {
                    startTime = Date.now();
                    if (progressBar) {
                        progressBar.style.transition = 'width ' + remaining + 'ms linear';
                        progressBar.style.width = '0%';
                    }
                    timeoutId = setTimeout(dismiss, remaining);
                }

                function pauseTimer() {
                    if (isPaused) return;
                    isPaused = true;
                    clearTimeout(timeoutId);
                    var elapsed = Date.now() - startTime;
                    remaining = Math.max(0, remaining - elapsed);
                    if (progressBar) {
                        var percent = (remaining / duration) * 100;
                        progressBar.style.transition = 'none';
                        progressBar.style.width = percent + '%';
                    }
                }

                function resumeTimer() {
                    if (!isPaused) return;
                    isPaused = false;
                    if (remaining <= 50) {
                        dismiss();
                    } else {
                        startTimer();
                    }
                }

                if (closeBtn) {
                    closeBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        clearTimeout(timeoutId);
                        dismiss();
                    });
                }

                msg.addEventListener('mouseenter', pauseTimer);
                msg.addEventListener('mouseleave', resumeTimer);

                // Initial start
                startTimer();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initFlashMessages);
        } else {
            initFlashMessages();
        }
    })();
    </script>
</c:if>
