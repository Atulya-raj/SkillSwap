<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="navbar">
    <div class="container">
        <a href="${pageContext.request.contextPath}/" class="brand-logo" id="nav-brand">
            <span>SkillSwap</span><span class="brand-dot">•</span>
        </a>
        <nav>
            <ul class="nav-links">
                <li><a href="${pageContext.request.contextPath}/browse" id="nav-browse">Browse</a></li>
                <li><a href="${pageContext.request.contextPath}/leaderboard" id="nav-leaderboard">Leaderboard</a></li>

                <c:choose>
                    <c:when test="${empty sessionScope.currentUser}">
                        <li><a href="${pageContext.request.contextPath}/login" id="nav-login">Sign In</a></li>
                        <li><a href="${pageContext.request.contextPath}/register" class="btn btn-accent btn-sm" id="nav-register">Join Now</a></li>
                    </c:when>
                    <c:otherwise>
                        <c:if test="${sessionScope.currentUser.role == 'STUDENT'}">
                            <li><a href="${pageContext.request.contextPath}/dashboard" id="nav-dashboard">Dashboard</a></li>
                            <li><a href="${pageContext.request.contextPath}/matches" id="nav-matches">Matches</a></li>
                            <li><a href="${pageContext.request.contextPath}/skills" id="nav-skills">My Skills</a></li>
                            <li><a href="${pageContext.request.contextPath}/availability" id="nav-availability">Schedule</a></li>
                            <li><a href="${pageContext.request.contextPath}/requests" id="nav-requests">Requests</a></li>
                            <li><a href="${pageContext.request.contextPath}/messages" id="nav-messages">Messages</a></li>
                            <li>
                                <a href="${pageContext.request.contextPath}/notifications" id="nav-notifications">
                                    Alerts
                                    <c:if test="${not empty unreadNotificationsCount && unreadNotificationsCount > 0}">
                                        <span class="nav-badge"><c:out value="${unreadNotificationsCount}"/></span>
                                    </c:if>
                                </a>
                            </li>
                            <li><a href="${pageContext.request.contextPath}/credits" id="nav-credits">Credits</a></li>
                        </c:if>

                        <c:if test="${sessionScope.currentUser.role == 'ADMIN'}">
                            <li><a href="${pageContext.request.contextPath}/admin" id="nav-admin-dashboard">Admin Overview</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/users" id="nav-admin-users">Users</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/catalog" id="nav-admin-catalog">Catalog</a></li>
                            <li><a href="${pageContext.request.contextPath}/admin/reports" id="nav-admin-reports">Reports</a></li>
                        </c:if>

                        <li class="nav-user">
                            <a href="${pageContext.request.contextPath}/profile" id="nav-profile" title="View Profile" style="padding:0;">
                                <div class="nav-avatar">
                                    <c:choose>
                                        <c:when test="${not empty sessionScope.currentUser.avatarPath}">
                                            <img src="${pageContext.request.contextPath}/avatar?id=${sessionScope.currentUser.id}" alt="Avatar" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
                                        </c:when>
                                        <c:otherwise>
                                            <c:out value="${fn:substring(sessionScope.currentUser.name, 0, 1)}"/>
                                        </c:otherwise>
                                    </c:choose>
                                </div>
                            </a>
                            <form action="${pageContext.request.contextPath}/logout" method="post" style="display:inline;margin:0;">
                                <input type="hidden" name="_csrf" value="${csrfToken}">
                                <button type="submit" class="btn btn-outline btn-sm" id="btn-logout" style="color:#FFFFFF;border-color:rgba(255,255,255,0.4);">Sign Out</button>
                            </form>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </nav>
    </div>
</header>

<div class="container flash-container">
    <c:if test="${not empty flashSuccess}">
        <div class="flash-message flash-success" id="flash-success-box"><c:out value="${flashSuccess}"/></div>
    </c:if>
    <c:if test="${not empty flashError}">
        <div class="flash-message flash-error" id="flash-error-box"><c:out value="${flashError}"/></div>
    </c:if>
    <c:if test="${not empty flashWarning}">
        <div class="flash-message flash-warning" id="flash-warning-box"><c:out value="${flashWarning}"/></div>
    </c:if>
    <c:if test="${not empty flashInfo}">
        <div class="flash-message flash-info" id="flash-info-box"><c:out value="${flashInfo}"/></div>
    </c:if>
</div>
